# build output
dist/

# Content is now tracked for Cloudflare Pages auto-deployment
# (previously ignored, now committed to repo)
# content/**

# generated types
.astro/

# build-time GitHub API cache
.cache/

# dependencies
node_modules/

# logs

# virtual environments
.venv/

# environment variables
.env
.env.local
.env.*.local
.env.production

# originals/ are served from Cloudflare R2 CDN (4.2GB, too large for git)
public/library/originals/

# Scrolly build output. Each scrolly's Vite project (under
# content/datastory/<slug>/) produces its own dist/ when
# scripts/build_scrolly.mjs runs (invoked via predev/prebuild).
# The dist/ is gitignored per-scrolly by their own local .gitignore;
# this top-level pattern covers any scrolly not yet bootstrapped.
content/datastory/*/dist/
content/datastory/*/node_modules/

# macOS / Windows
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
.qodo/
.windsurf/
*.swp
*.swo

# misc
dirstruct.txt
.cursorrules

# Cloudflare Wrangler
.wrangler/
.wrangler.toml.bak

playwright-report/
