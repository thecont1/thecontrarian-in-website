# Cloudflare Pages headers
# All pages (including pretty URLs like /code/flatwrite) must revalidate
# so they always reference current hashed asset filenames.
/* 
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; frame-src 'none'; script-src 'self' 'unsafe-inline' 'report-sample' https://cdn.jsdelivr.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline' 'report-sample' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://library.thecontrarian.in https://apps.thecontrarian.in; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://apps.thecontrarian.in; manifest-src 'self'; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed Astro assets are immutable — cache aggressively (overrides /* rule)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
