---
import { getCollection } from "astro:content";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import C2PAOverlay from "../../components/ui/C2PAOverlay.astro";
import { AUTHOR } from "../../data/author";
import "../../styles/fonts.css";
import "../../styles/global.css";
import "../../styles/header.css";
import "../../styles/footer.css";

const codeProjects = await getCollection("code", ({ data }) => data.status === "published");

const title = "Code Projects | Mahesh Shantaram";
const description = "Open source projects and creative coding experiments by Mahesh Shantaram.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(AUTHOR.image, Astro.site).href;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name,
  url: AUTHOR.url,
  jobTitle: AUTHOR.jobTitle,
  sameAs: AUTHOR.sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="google-adsense-account" content="ca-pub-3564536130489009" />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mahesh Shantaram" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@thecontrarian" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>

  <body>
    <canvas id="snow-canvas" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    
    <main id="main-content" class="code-index" tabindex="-1">
      <header class="code-header">
        <div class="code-kicker">
          <span class="collection-type">Open Source</span>
        </div>
        <h1 class="code-title">Code</h1>
        <p class="code-subtitle">Open source projects and creative coding experiments</p>
      </header>

      <div class="projects-grid">
        {codeProjects.map((project) => (
          <article class="project-card">
            <a href={`/code/${project.id}`}>
              <div class="card-header">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" class="github-icon">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                </svg>
                <h2>{project.data.repoOwner}/{project.data.repoName}</h2>
              </div>
              
              <p class="description">{project.data.description}</p>
              
              <div class="project-meta">
                {project.data.license && <span class="license">{project.data.license}</span>}
              </div>
              
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="tags">
                  {project.data.tags.slice(0, 3).map(tag => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    </main>

    <SiteFooter />
    <C2PAOverlay />
    <script is:inline src="/textmode.js" defer></script>
    <script is:inline src="/snow-loader.js" defer></script>
    <script is:inline src="/mobile-nav.js" defer></script>
  </body>
</html>

<style>
  .code-index {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    background: #0c1222;
    min-height: 100vh;
    color: #c9d1d9;
  }

  /* ── Code Header — dark data journalism aesthetic ────── */
  .code-header {
    background: #0c1222;
    padding: 7rem 2rem 0;
    text-align: center;
    margin: 0 -2rem;
    max-width: none;
  }

  .code-kicker {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 3px solid #58a6ff;
    margin-bottom: 2rem;
  }

  .code-kicker .collection-type {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #0c1222;
    background: #58a6ff;
    padding: 0.2em 0.65em;
    border-radius: 2px;
  }

  .code-title {
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: #e6edf3;
    max-width: 18ch;
    margin: 0 auto 1.5rem;
  }

  .code-subtitle {
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(230, 237, 243, 0.6);
    max-width: 55ch;
    margin: 0 auto 3rem;
  }

  /* ── Projects Grid ──────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: #0f1829;
    border: 1px solid #1c2a3e;
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    border-color: #2d3a4e;
  }

  .project-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .github-icon {
    flex-shrink: 0;
    color: #c9d1d9;
  }

  .card-header h2 {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #e6edf3;
    margin: 0;
  }

  .description {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #8b949e;
    margin-bottom: 1rem;
  }

  .project-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .license {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: #c9d1d9;
    background: #1c2a3e;
    padding: 0.2em 0.6em;
    border-radius: 3px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.75rem;
    color: #556;
  }

  /* ── Mobile ─────────────────────────────────────────── */
  @media (max-width: 768px) {
    .code-header {
      padding: 5rem 1rem 0;
      margin: 0 -1rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
