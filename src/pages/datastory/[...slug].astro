---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Datastory from "../../layouts/Datastory.astro";
import SchemaMarkup from "../../components/seo/SchemaMarkup.astro";
import fs from "node:fs";
import path from "node:path";

export const prerender = true;

export async function getStaticPaths() {
  const stories = await getCollection("datastory", ({ data }) => {
    return data.status === "published";
  });
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Scrolly dispatch.
 *
 * Scrolly entries are pre-built into public/<baseUrl>/ by the
 * `scripts/build_scrolly.mjs` prebuild/predev step. We don't re-render
 * them through Astro; we serve the pre-built HTML directly. The format
 * is invisible to the public (same URL, no badge, no marker).
 *
 * The route file is shared between notebook and scrolly entries — the
 * dispatcher below picks the right path. In dev, the public/ file is
 * rebuilt on every scrolly source change (see scaffold-integration.ts).
 */
if (story.data.format === "scrolly") {
  // baseUrl is a URL path (starts with "/"), not a filesystem path.
  // Strip the leading slash to use it as a relative public/ path.
  const relativePath = story.data.baseUrl.replace(/^\/+/, "");
  const publicFile = path.resolve(process.cwd(), "public", relativePath, "index.html");
  if (fs.existsSync(publicFile)) {
    const html = fs.readFileSync(publicFile, "utf-8");
    return new Response(html, {
      status: 200,
      headers: { "content-type": "text/html; charset=utf-8" },
    });
  }
  // File missing — likely the predev step didn't run or build failed.
  // Fail loud so the user knows to re-run predev/prebuild.
  return new Response(
    `<!doctype html><meta charset="utf-8"><title>Scrolly build missing</title>` +
    `<body style="font-family:system-ui;padding:2rem;max-width:60ch">` +
    `<h1>Scrolly build missing</h1>` +
    `<p>The datastory <code>${story.id}</code> is configured as <code>format: scrolly</code> ` +
    `but the prebuilt file at <code>public/${story.data.baseUrl}index.html</code> does not exist.</p>` +
    `<p>Run <code>node scripts/build_scrolly.mjs</code> (or <code>bun run dev</code> / ` +
    `<code>npm run build</code>, which invoke it via predev/prebuild).</p>` +
    `</body>`,
    { status: 500, headers: { "content-type": "text/html; charset=utf-8" } },
  );
}
---

<Layout
  title={story.data.title}
  description={story.data.metaDescription || story.data.subtitle}
  image={story.data.heroImage}
  type="article"
  publishedDate={story.data.date?.toISOString()}
>
  <Fragment slot="head">
    <SchemaMarkup
      title={story.data.title}
      description={story.data.metaDescription || story.data.subtitle}
      image={story.data.heroImage}
      datePublished={story.data.date?.toISOString()}
      type="datastory"
      url={canonicalURL}
    />
  </Fragment>
  <Datastory post={story} />
</Layout>
