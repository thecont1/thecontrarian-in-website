---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Datastory from "../../layouts/Datastory.astro";
import SchemaMarkup from "../../components/seo/SchemaMarkup.astro";
import fs from "node:fs";
import path from "node:path";

export const prerender = true;

export async function getStaticPaths() {
  const stories = await getCollection("datastory", ({ data }) => {
    return data.status === "published";
  });
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Scrolly dispatch.
 *
 * Scrolly entries are pre-built by `scripts/build_scrolly.mjs` (run via
 * predev/prebuild) into <source>/dist/ — colocated with the scrolly's
 * Vite project at content/datastory/<slug>/dist/. We read
 * <source>/dist/index.html and return it as a Response. The bundled
 * assets (assets/, data/) are copied to dist/datastory/<slug>/{assets,data}/
 * by the post-build hook in scaffold-integration.ts.
 *
 * The format is invisible to the public (same URL, no badge, no marker).
 * The route file is shared between notebook and scrolly entries — the
 * dispatcher below picks the right path.
 */
if (story.data.format === "scrolly") {
  // `source` is a path relative to the .md entry's directory
  // (content/datastory/). Resolve it against the .md's location, which
  // for an Astro content collection entry is content/datastory/.
  const sourcePath = path.resolve(
    process.cwd(),
    "content",
    "datastory",
    story.data.source,
  );
  const scrollyIndex = path.join(sourcePath, "dist", "index.html");
  if (fs.existsSync(scrollyIndex)) {
    const html = fs.readFileSync(scrollyIndex, "utf-8");
    return new Response(html, {
      status: 200,
      headers: { "content-type": "text/html; charset=utf-8" },
    });
  }
  // File missing — likely the predev step didn't run or build failed.
  // Fail loud so the user knows to re-run predev/prebuild.
  return new Response(
    `<!doctype html><meta charset="utf-8"><title>Scrolly build missing</title>` +
    `<body style="font-family:system-ui;padding:2rem;max-width:60ch">` +
    `<h1>Scrolly build missing</h1>` +
    `<p>The datastory <code>${story.id}</code> is configured as <code>format: scrolly</code> ` +
    `but the prebuilt file at <code>${scrollyIndex}</code> does not exist.</p>` +
    `<p>Run <code>node scripts/build_scrolly.mjs</code> (or <code>bun run dev</code> / ` +
    `<code>npm run build</code>, which invoke it via predev/prebuild).</p>` +
    `</body>`,
    { status: 500, headers: { "content-type": "text/html; charset=utf-8" } },
  );
}
---

<Layout
  title={story.data.title}
  description={story.data.metaDescription || story.data.subtitle}
  image={story.data.heroImage}
  type="article"
  publishedDate={story.data.date?.toISOString()}
>
  <Fragment slot="head">
    <SchemaMarkup
      title={story.data.title}
      description={story.data.metaDescription || story.data.subtitle}
      image={story.data.heroImage}
      datePublished={story.data.date?.toISOString()}
      type="datastory"
      url={canonicalURL}
    />
  </Fragment>
  <Datastory post={story} />
</Layout>
