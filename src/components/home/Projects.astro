---
/**
 * Projects Section - Homepage
 *
 * Displays manually curated featured content from src/data/featured.ts and a
 * Products section synced from the apps portfolio (content/code entries).
 */
import { getCollection, getEntry } from "astro:content";
import { FEATURED_ITEMS, FEATURED_SECTIONS, type FeaturedItem } from "../../data/featured";

// Helper to normalize public paths
const normalizePublicPath = (p?: string) => (p ? p.replace(/^\/public\//, "/") : p);

// Check if a path points to a valid image (CDN URLs, /library/ paths, or any absolute path)
const hasPublicFile = (p?: string) => {
  if (!p) return false;
  if (/^https?:\/\//i.test(p)) return true;
  if (p.startsWith('/library/')) return true;
  // Any other root-relative path is assumed valid
  return p.startsWith('/');
};

// URL mapping for each collection type
const getContentUrl = (type: string, slug: string): string => {
  const urlMap: Record<string, string> = {
    photogallery: `/photogallery/${slug}`,
    essay: `/essay/${slug}`,
    longform: `/longform/${slug}`,
    post: `/post/${slug}`,
    datastory: `/datastory/${slug}`,
    code: `/code/${slug}`,
    project: `/project/${slug}`,
  };
  return urlMap[type] || `/${type}/${slug}`;
};

// Resolve the best image source for a card.
// Root-relative /library/ files live in public/ and should be served directly;
// the Cloudflare image Worker at library.thecontrarian.in 404s for these.
function getCardImage(item: Awaited<ReturnType<typeof getFeaturedContent>> | ProductItem) {
  const heroSrc = normalizePublicPath(item?.heroImage);
  const codeData = item.type === 'code' ? (item as any).entry?.data : null;
  const fallbackSrc = codeData?.repoOwner && codeData?.repoName
    ? `https://opengraph.githubassets.com/1/${codeData.repoOwner}/${codeData.repoName}`
    : null;

  if (heroSrc && (heroSrc.startsWith('http') || hasPublicFile(heroSrc))) {
    return { src: heroSrc };
  }

  return { src: fallbackSrc };
}

// Fetch content for a featured item
async function getFeaturedContent(item: FeaturedItem) {
  try {
    const entry = await getEntry(item.type, item.slug);
    if (!entry) return null;
    if ((entry.data as any).status !== "published") return null;

    return {
      ...item,
      entry,
      title: item.displayTitle || entry.data.title,
      subtitle: item.displaySubtitle || (entry.data as any).subtitle || (entry.data as any).description || "",
      heroImage: item.displayImage || (entry.data as any).heroImage,
      url: getContentUrl(item.type, item.slug),
    };
  } catch (e) {
    return null;
  }
}

// Determine which mode to use: flat list or sections
const useSections = FEATURED_SECTIONS.length > 0;

// Fetch all featured content
let flatItems: Awaited<ReturnType<typeof getFeaturedContent>>[] = [];
let sectionedItems: { title: string; items: Awaited<ReturnType<typeof getFeaturedContent>>[] }[] = [];

if (useSections) {
  // Grouped by sections
  for (const section of FEATURED_SECTIONS) {
    const items = await Promise.all(section.items.map(getFeaturedContent));
    sectionedItems.push({
      title: section.title,
      items: items.filter(Boolean),
    });
  }
} else {
  // Flat list
  flatItems = (await Promise.all(FEATURED_ITEMS.map(getFeaturedContent))).filter(Boolean);
}

// Build the Products section from the synced code collection.
interface ProductItem {
  type: "product";
  entry: any;
  slug: string;
  title: string;
  subtitle: string;
  heroImage?: string;
  url: string;
  appUrl?: string;
  repoUrl?: string;
}

const allCode = await getCollection("code", ({ data }) => data.status === "published");
const productItems: ProductItem[] = allCode
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((entry) => ({
    type: "product",
    entry,
    slug: entry.id,
    title: entry.data.title,
    subtitle: entry.data.description || "",
    heroImage: entry.data.heroImage,
    url: getContentUrl("code", entry.id),
    appUrl: entry.data.appUrl,
    repoUrl: entry.data.repoUrl,
  }));

// Insert the Products section right after Data Science, or at the end if not found.
const finalSections = [];
let productsInserted = false;
for (const section of sectionedItems) {
  finalSections.push(section);
  if (section.title === "Data Science") {
    finalSections.push({ title: "Products", items: productItems as any });
    productsInserted = true;
  }
}
if (!productsInserted) {
  finalSections.push({ title: "Products", items: productItems as any });
}

// Type icons for each content type
const typeIcons: Record<string, string> = {
  post: "✏️",
  essay: "📝",
  longform: "📖",
  photogallery: "📷",
  code: "💻",
  datastory: "📊",
  project: "🎯",
  product: "🎯",
};

const isProduct = (item: any): item is ProductItem => item?.type === "product";

function displayUrl(url: string) {
  return String(url).replace(/^https?:\/\//i, "").replace(/\/$/, "");
}
---

<section id="projects" class="projects">
  <header class="projects-header">
    <h2 class="projects-title">The Projects</h2>
  </header>

  {finalSections.map((section) => section.items.length > 0 && (
    <div class="projects-section">
      <div class="projects-label">{section.title}</div>
      <div class="projects-row">
        {section.items.map((item: any) => item && (
          <article class={`project-card ${isProduct(item) ? "product-card" : `${item.type}-card`}`}>
            {isProduct(item) ? (
              <>
                <div class="card-media product-media">
                  <a href={item.url} class="product-thumb-link" tabindex="-1" aria-hidden="true">
                    {(() => {
                      const { src } = getCardImage(item);
                      return src ? (
                        <img
                          src={src}
                          alt={item.title}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="card-placeholder-icon">
                          <span>{typeIcons[item.type] || "🎯"}</span>
                        </div>
                      );
                    })()}
                  </a>
                  {item.label && <span class="card-label">{item.label}</span>}
                </div>
                <div class="card-content product-content">
                  <a class="product-title-link" href={item.url}>
                    <h3>{item.title}</h3>
                    <svg class="product-repo-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                      <path d="M8 .198a8 8 0 0 0-2.529 15.591c.4.074.547-.174.547-.385 0-.191-.008-.821-.011-1.489-2.226.484-2.695-.944-2.695-.944-.364-.925-.888-1.171-.888-1.171-.726-.497.055-.486.055-.486.803.056 1.226.824 1.226.824.714 1.223 1.872.869 2.328.665.072-.517.279-.87.508-1.07-1.777-.202-3.645-.888-3.645-3.954 0-.873.313-1.587.824-2.147-.083-.202-.357-1.015.077-2.117 0 0 .672-.215 2.201.82A7.672 7.672 0 0 1 8 4.066c.68.003 1.365.092 2.004.269 1.527-1.035 2.198-.82 2.198-.82.435 1.102.162 1.916.079 2.117.513.56.823 1.274.823 2.147 0 3.073-1.872 3.749-3.653 3.947.287.248.543.735.543 1.481 0 1.07-.009 1.932-.009 2.195 0 .213.144.462.55.384A8 8 0 0 0 8.001.196z"/>
                    </svg>
                  </a>
                  <p>{item.subtitle}</p>
                  {item.appUrl && (
                    <a
                      class="product-live-link"
                      href={item.appUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg class="product-live-icon" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                        <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0z"/>
                      </svg>
                      {displayUrl(item.appUrl)}
                    </a>
                  )}
                </div>
              </>
            ) : (
              <a href={item.url}>
                <div class="card-media">
                  {(() => {
                    const { src } = getCardImage(item);
                    return src ? (
                      <img
                        src={src}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="card-placeholder-icon">
                        <span>{typeIcons[item.type] || "📄"}</span>
                      </div>
                    );
                  })()}
                  {item.label && <span class="card-label">{item.label}</span>}
                </div>
                <div class="card-content">
                  <h3>{item.title}</h3>
                  <p>{item.subtitle}</p>
                </div>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  ))}
</section>
