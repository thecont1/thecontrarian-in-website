---
import HeroStatement from "./Statement.astro";
import Carousel from "../carousel/Carousel.tsx";
import { CAROUSEL_IMAGES } from "../../data/carousel";
import "../../styles/home.css";
import "../../styles/carousel.css";
import "../../styles/info-panel.css";
import { mapWithConcurrency } from "../../utils/api";
import { getImageCaption, getImageMetadata } from "../../utils/exif";

const images = await mapWithConcurrency(
  CAROUSEL_IMAGES,
  async (img) => {
    const meta = await getImageMetadata(img.src);
    const caption = getImageCaption(meta) || '';

    return {
      src: img.src,
      caption,
      alt: caption,
      width: meta?.width,
      height: meta?.height,
      metadata: meta || {},
    };
  },
  4
);
---

<section class="home-hero">
  <h1 class="sr-only">Mahesh Shantaram — Documentary Photographer and Data Scientist</h1>

  <!-- Curtain: rendered FIRST in the DOM so the hero text is the first
       thing the user reads while the first carousel image streams in.
       The frosted curtain is position:fixed and the Carousel is
       position:fixed behind it, so the DOM order here is purely about
       source-order / accessibility, not visual stacking. -->
  <HeroStatement />

  <!-- Fixed carousel layer (rendered after the curtain so the curtain
       paints on top in stacking-order terms if z-index is ever reset). -->
  <div class="hero-fixed">
    <Carousel images={images} client:load />
  </div>
</section>
