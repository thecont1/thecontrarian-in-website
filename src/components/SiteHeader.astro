---
import IconClose from "./icons/IconClose.astro";
import { navLinks } from "../data/nav";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-title">thecontrarian.in</a>

    <!-- Desktop Navigation -->
    <nav class="site-nav desktop-nav" aria-label="Main navigation">
      {navLinks.map((l) => (
        <a href={l.href} aria-current={isHome && l.href === "/#" ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="site-actions">
      <button id="toggle-textmode" class="icon-btn" aria-label="Text only mode" aria-pressed="false" title="Text only mode">
        <svg viewBox="0 0 24 24" class="eye-icon" aria-hidden="true">
          <path d="M1.5 12s4-7 10.5-7 10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z"/>
          <circle cx="12" cy="12" r="3.5"/>
          <line x1="3" y1="3" x2="21" y2="21" class="eye-slash"/>
        </svg>
      </button>

      <button id="toggle-snow" class="icon-btn" aria-label="Toggle snow" aria-pressed="false" title="Toggle snow">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m8.25-8.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-7.5A2.25 2.25 0 0 1 8.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 0 0-2.25 2.25v6"/>
        </svg>
      </button>

      <!-- Mobile Navigation Toggle -->
      <button class="mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-haspopup="menu" aria-controls="mobile-nav">
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <nav id="mobile-nav" class="site-nav mobile-nav" aria-hidden="true" aria-label="Mobile navigation" inert>
      <div class="mobile-nav-overlay"></div>
      <div class="mobile-nav-content">
        <button class="mobile-nav-close" aria-label="Close navigation menu">
          <IconClose class="mobile-nav-close-icon" width="24" height="24" aria-hidden="true" />
        </button>
        {navLinks.map((l) => (
          <a href={l.href} aria-current={isHome && l.href === "/#" ? "page" : undefined}>{l.label}</a>
        ))}
      </div>
    </nav>
  </div>
</header>

