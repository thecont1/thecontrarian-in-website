---
import { render, type CollectionEntry } from "astro:content";
import Lightbox from "../ui/Lightbox.astro";
import ContentsToggle from "../ui/ContentsToggle.astro";
import ScreenToggle from "../ui/ScreenToggle.astro";
import Note from "../ui/Note.astro";
import "../../styles/longform.css";

interface Props {
  post: CollectionEntry<"longform">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const backgroundColor = post.data.backgroundColor || "#ffffff";

// Build chapter structure: H2s are chapters, H3s are sections within chapters
const chapters = headings.filter((h) => h.depth === 2);
const allHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const lightboxEnabled = post.data.lightbox?.gallery !== false;

// Build nested TOC structure
interface TocItem {
  slug: string;
  text: string;
  depth: number;
  sections?: TocItem[];
}

const tocStructure: TocItem[] = [];
let currentChapter: TocItem | null = null;

allHeadings.forEach((h) => {
  if (h.depth === 2) {
    currentChapter = { slug: h.slug, text: h.text, depth: 2, sections: [] };
    tocStructure.push(currentChapter);
  } else if (h.depth === 3 && currentChapter) {
    currentChapter.sections?.push({ slug: h.slug, text: h.text, depth: 3 });
  }
});

// Formatting date
const formattedDate = post.data.date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="longform-post" style={`--page-bg: ${backgroundColor};`}>
  <header class="post-header">
    <div class="post-meta-top">
      <span class="collection-type">Longform</span>
      {(post.data as any).category && <span class="category">{(post.data as any).category}</span>}
    </div>
    
    <h1 class="post-title">{post.data.title}</h1>
    
    {post.data.subtitle && <p class="post-lead">{post.data.subtitle}</p>}

    <div class="post-author-line">
      <span class="by">by</span>
      <span class="author-name">{post.data.author}</span>
    </div>

    {formattedDate && (
      <div class="post-date-line">
        <time datetime={post.data.date?.toISOString()}>{formattedDate}</time>
      </div>
    )}

    {post.data.showhero !== false && post.data.showhero !== "false" && post.data.heroImage && (
      <figure class="post-hero">
        <img src={post.data.heroImage} alt={post.data.title} />
      </figure>
    )}
  </header>

  <div class="longform-layout-container">
    {post.data.toc !== false && tocStructure.length > 0 && (
      <ContentsToggle title={post.data.title} label="Contents">
        <ul class="longform-toc">
          {tocStructure.map((chapter, idx) => (
            <li class={idx === 0 ? 'active' : ''} data-chapter={chapter.slug}>
              <a href={`#${chapter.slug}`}>{chapter.text}</a>
              {chapter.sections && chapter.sections.length > 0 && (
                <ul class="section-list">
                  {chapter.sections.map((section) => (
                    <li class="section-item">
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </ContentsToggle>
    )}

    <div class="post-body" id="longform-content">
      <Content components={{ Note, note: Note }} />
    </div>
  </div>

  {lightboxEnabled && (
    <Lightbox selector=".longform-post" gallery={true} />
  )}
  <ScreenToggle />
</article>

<script>
  /* ─── Longform Grid Layout ─── */

  function stackRightFigures() {
    const content = document.getElementById('longform-content');
    if (!content) return;

    const children = Array.from(content.children);
    let i = 0;
    while (i < children.length) {
      const el = children[i];
      if (el.classList.contains('right') && el.tagName === 'FIGURE') {
        // Look ahead for consecutive right figures
        let j = i + 1;
        while (j < children.length && children[j].classList.contains('right') && children[j].tagName === 'FIGURE') {
          j++;
        }
        if (j > i + 1) {
          // Wrap [i .. j-1] in a stack
          const stack = document.createElement('div');
          stack.className = 'right-stack';
          const first = children[i];
          content.insertBefore(stack, first);
          for (let k = i; k < j; k++) {
            stack.appendChild(children[k]);
          }
        }
        i = j;
      } else {
        i++;
      }
    }
  }

  function autoCaptions() {
    const content = document.getElementById('longform-content');
    if (!content) return;
    content.querySelectorAll('img').forEach(img => {
      const imgEl = img as HTMLImageElement;
      // Skip inline-float images — they stay inside their paragraph for text wrapping
      if (imgEl.classList.contains('inline-left') || imgEl.classList.contains('inline-right')) {
        return;
      }
      if (imgEl.alt && !imgEl.closest('figure')?.querySelector('figcaption')) {
        const existingFigure = imgEl.closest('figure');
        const figure = existingFigure || document.createElement('figure');
        if (!existingFigure) {
          // Preserve any class on the <img> (e.g. .right from Markdown {right})
          if (imgEl.className) {
            figure.className = imgEl.className;
          }
          const parent = imgEl.parentNode as HTMLElement | null;
          const nextSibling = imgEl.nextSibling;
          figure.appendChild(imgEl);
          if (parent && parent.tagName === 'P') {
            if (parent.textContent?.trim() === '') {
              parent.parentNode?.replaceChild(figure, parent);
            } else {
              parent.parentNode?.insertBefore(figure, parent);
            }
          } else if (parent) {
            parent.insertBefore(figure, nextSibling);
          }
        }
        const caption = document.createElement('figcaption');
        caption.className = 'image-caption';
        caption.textContent = imgEl.alt;
        figure.appendChild(caption);
      }
    });
  }

  // Wrap inline-float images that are direct children of post-body
  // This groups the image with its following text so float wrapping works
  function wrapInlineFloats() {
    const content = document.getElementById('longform-content');
    if (!content) return;

    const inlineImages = content.querySelectorAll(':scope > img.inline-left, :scope > img.inline-right');
    inlineImages.forEach(img => {
      const parent = img.parentNode as HTMLElement;
      if (!parent || !parent.classList.contains('post-body')) return;

      // Collect all sibling nodes after the image until we hit a block element
      const nodesToWrap: Node[] = [];
      let sibling = img.nextSibling;
      while (sibling) {
        // Stop at block-level elements (paragraphs, headings, figures, etc.)
        if (sibling.nodeType === Node.ELEMENT_NODE) {
          const tagName = (sibling as HTMLElement).tagName.toLowerCase();
          if (['p', 'h2', 'h3', 'h4', 'blockquote', 'figure', 'ul', 'ol', 'div', 'img'].includes(tagName)) {
            break;
          }
        }
        // Also stop if we hit a <p> or other block element
        if (sibling.nodeType === Node.ELEMENT_NODE && (sibling as HTMLElement).matches?.('p, h2, h3, h4, blockquote, figure, ul, ol')) {
          break;
        }
        nodesToWrap.push(sibling);
        sibling = sibling.nextSibling;
      }

      // Only wrap if there's text content
      const hasText = nodesToWrap.some(n => 
        n.nodeType === Node.TEXT_NODE && n.textContent?.trim()
      ) || nodesToWrap.length > 0;

      if (hasText) {
        const wrapper = document.createElement('p');
        wrapper.className = 'inline-float-wrap';
        
        // Move image into wrapper
        wrapper.appendChild(img);
        
        // Move all collected nodes into wrapper
        nodesToWrap.forEach(node => wrapper.appendChild(node));
        
        // Insert wrapper where the image was
        parent.insertBefore(wrapper, img.nextSibling);
      }
    });
  }

  function positionRightImages() {
    const content = document.getElementById('longform-content');
    if (!content) return;

    const rightElements = content.querySelectorAll('.right, .right-stack');

    rightElements.forEach((el) => {
      const htmlEl = el as HTMLElement;
      
      // Find first non-right preceding sibling
      let sibling = htmlEl.previousElementSibling;
      while (sibling && (sibling.classList.contains('right') || sibling.classList.contains('right-stack'))) {
        sibling = sibling.previousElementSibling;
      }
      
      // Align with preceding left sibling's top
      if (sibling) {
        htmlEl.style.top = `${(sibling as HTMLElement).offsetTop}px`;
      }
      htmlEl.style.left = '';  // Let CSS handle horizontal positioning
    });
  }

  function syncHeaderBg() {
    const article = document.querySelector('.longform-post') as HTMLElement;
    if (!article) return;
    const bgColor = getComputedStyle(article).getPropertyValue('--page-bg').trim();
    const header = document.querySelector('.site-header') as HTMLElement;
    if (header && bgColor) {
      header.style.backgroundColor = bgColor;
      header.style.transition = 'background-color 0.3s ease';
      const headerInner = header.querySelector('.site-header-inner') as HTMLElement;
      if (headerInner) headerInner.style.backgroundColor = 'transparent';
    }
  }

  function setupTocHighlight() {
    const tocItems = document.querySelectorAll('.sticky-toc ul > li[data-chapter]');
    if (tocItems.length === 0) return;

    const h2s = document.querySelectorAll('#longform-content > h2, #longform-content > section > h2');
    if (h2s.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the h2 closest to the reading line (45% from top)
        let best: Element | null = null;
        let bestDist = Infinity;
        const readY = window.innerHeight * 0.45;

        // Update our intersection map
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const rect = (entry.target as HTMLElement).getBoundingClientRect();
            const center = rect.top + rect.height / 2;
            const dist = Math.abs(center - readY);
            if (dist < bestDist) {
              bestDist = dist;
              best = entry.target;
            }
          }
        });

        if (!best) return;

        const slug = (best as HTMLElement).id;
        if (!slug) return;

        tocItems.forEach(item => {
          item.classList.toggle('active', (item as HTMLElement).dataset.chapter === slug);
        });
      },
      { rootMargin: '-30% 0px -30% 0px', threshold: 0 }
    );

    h2s.forEach(h => observer.observe(h));
  }

  function init() {
    document.body.classList.add('no-snow');
    document.body.classList.add('page-longform');
    autoCaptions();
    wrapInlineFloats();
    stackRightFigures();
    positionRightImages();
    setupTocHighlight();
    syncHeaderBg();
  }

  init();
  document.addEventListener('astro:page-load', init);

  // Reposition right images on resize and after images load
  window.addEventListener('resize', positionRightImages);
  document.querySelectorAll('#longform-content img').forEach(img => {
    img.addEventListener('load', positionRightImages);
  });
  setTimeout(positionRightImages, 100);
  setTimeout(positionRightImages, 500);
</script>
