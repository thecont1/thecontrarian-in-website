---
import { render, type CollectionEntry } from "astro:content";
import Lightbox from "../ui/Lightbox.astro";
import ContentsToggle from "../ui/ContentsToggle.astro";
import ScreenToggle from "../ui/ScreenToggle.astro";
import C2PAOverlay from "../ui/C2PAOverlay.astro";
import Note from "../ui/Note.astro";
import "../../styles/longform.css";

interface Props {
  post: CollectionEntry<"longform">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const backgroundColor = post.data.backgroundColor || "#ffffff";

// Build chapter structure: H2s are chapters, H3s are sections within chapters
const chapters = headings.filter((h) => h.depth === 2);
const allHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const lightboxEnabled = post.data.lightbox?.gallery !== false;

// Build nested TOC structure
interface TocItem {
  slug: string;
  text: string;
  depth: number;
  sections?: TocItem[];
}

const tocStructure: TocItem[] = [];
let currentChapter: TocItem | null = null;

allHeadings.forEach((h) => {
  if (h.depth === 2) {
    currentChapter = { slug: h.slug, text: h.text, depth: 2, sections: [] };
    tocStructure.push(currentChapter);
  } else if (h.depth === 3 && currentChapter) {
    currentChapter.sections?.push({ slug: h.slug, text: h.text, depth: 3 });
  }
});

// Formatting date
const formattedDate = post.data.date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="longform-post" style={`--page-bg: ${backgroundColor};`}>
  <header class="post-header">
    <div class="post-meta-top">
      <span class="collection-type">Longform</span>
      {(post.data as any).category && <span class="category">{(post.data as any).category}</span>}
    </div>
    
    <h1 class="post-title">{post.data.title}</h1>
    
    {post.data.subtitle && <p class="post-lead">{post.data.subtitle}</p>}

    <div class="post-author-line">
      <span class="by">by</span>
      <span class="author-name">{post.data.author}</span>
    </div>

    {formattedDate && (
      <div class="post-date-line">
        <time datetime={post.data.date?.toISOString()}>{formattedDate}</time>
      </div>
    )}

    {post.data.showhero !== false && post.data.heroImage && (
      <figure class="post-hero">
        <img src={post.data.heroImage} alt={post.data.title} />
      </figure>
    )}
  </header>

  <div class="longform-layout-container">
    {post.data.toc !== false && tocStructure.length > 0 && (
      <ContentsToggle title={post.data.title} label="Chapters">
        <ul class="longform-toc">
          {tocStructure.map((chapter, idx) => (
            <li class={idx === 0 ? 'active' : ''} data-chapter={chapter.slug}>
              <a href={`#${chapter.slug}`}>{chapter.text}</a>
              {chapter.sections && chapter.sections.length > 0 && (
                <ul class="section-list">
                  {chapter.sections.map((section) => (
                    <li class="section-item">
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </ContentsToggle>
    )}

    <div class="post-body" id="longform-content">
      <Content components={{ Note, note: Note }} />
    </div>
  </div>

  {lightboxEnabled && (
    <Lightbox selector=".longform-post" gallery={true} />
  )}
  <ScreenToggle />
  <C2PAOverlay />
</article>

<script>
  /* ─── Scrollytelling Visual Essay ─── */

  interface ScrollyStep {
    elements: HTMLElement[];
    mediaId: number;
    h3?: HTMLElement;
  }

  interface ScrollyChapter {
    heading: HTMLElement;
    elements: HTMLElement[];
    steps: ScrollyStep[];
  }

  /* ─── Utilities ─── */

  function autoCaptions() {
    const content = document.getElementById('longform-content');
    if (!content) return;
    content.querySelectorAll('img').forEach(img => {
      const imgEl = img as HTMLImageElement;
      if (imgEl.alt && !imgEl.closest('figure')?.querySelector('figcaption')) {
        const figure = imgEl.closest('figure') || document.createElement('figure');
        if (!imgEl.closest('figure')) {
          imgEl.parentNode?.insertBefore(figure, imgEl);
          figure.appendChild(imgEl);
        }
        const caption = document.createElement('figcaption');
        caption.className = 'image-caption';
        caption.textContent = imgEl.alt;
        figure.appendChild(caption);
      }
    });
  }

  function setupDropcaps() {
    const content = document.getElementById('longform-content');
    if (!content) return;
    content.querySelectorAll('.dropcap').forEach(p => {
      const text = (p as HTMLElement).textContent || "";
      if (text.length > 0) {
        (p as HTMLElement).setAttribute('data-letter', text.charAt(0));
      }
    });
  }

  function syncHeaderBg() {
    const article = document.querySelector('.longform-post') as HTMLElement;
    if (!article) return;
    const bgColor = getComputedStyle(article).getPropertyValue('--page-bg').trim();
    const header = document.querySelector('.site-header') as HTMLElement;
    if (header && bgColor) {
      header.style.backgroundColor = bgColor;
      header.style.transition = 'background-color 0.3s ease';
      const headerInner = header.querySelector('.site-header-inner') as HTMLElement;
      if (headerInner) headerInner.style.backgroundColor = 'transparent';
    }
  }

  /* ─── Scrollytelling Setup ─── */

  function setupScrollytelling() {
    const content = document.getElementById('longform-content');
    const layoutContainer = document.querySelector('.longform-layout-container');
    if (!content || !layoutContainer) return;
    if (content.dataset.scrolly === 'true') return;

    const children = Array.from(content.children) as HTMLElement[];
    const h2s = children.filter(el => el.tagName === 'H2');
    if (h2s.length === 0) return;

    content.dataset.scrolly = 'true';
    const postBody = content; // non-null after guard

    // 1. Parse children into chapters
    const introElements: HTMLElement[] = [];
    const chapters: ScrollyChapter[] = [];
    let current: ScrollyChapter | null = null;

    children.forEach(el => {
      if (el.tagName === 'H2') {
        current = { heading: el, elements: [], steps: [] };
        chapters.push(current);
      } else if (current) {
        current.elements.push(el);
      } else {
        introElements.push(el);
      }
    });

    // 2. For each chapter, identify steps by H3s or figures
    let nextMediaId = 0;
    const allMedia: { id: number; figure: HTMLElement }[] = [];

    function isExtractable(el: HTMLElement): boolean {
      if (el.tagName === 'FIGURE') return true;
      if (el.tagName === 'IMG' && !el.closest('figure')) return true;
      return false;
    }

    chapters.forEach(ch => {
      const h3s = ch.elements.filter(el => el.tagName === 'H3');
      const hasFigures = ch.elements.some(el => isExtractable(el));

      if (h3s.length > 0) {
        // H3-based steps
        const steps: ScrollyStep[] = [];
        let cur: ScrollyStep = { elements: [], mediaId: -1 };

        ch.elements.forEach(el => {
          if (el.tagName === 'H3') {
            if (cur.elements.length > 0 || cur.h3) steps.push(cur);
            cur = { elements: [], mediaId: -1, h3: el };
          } else {
            cur.elements.push(el);
            if (isExtractable(el) && cur.mediaId === -1) {
              const mId = nextMediaId++;
              allMedia.push({ id: mId, figure: el });
              cur.mediaId = mId;
            }
          }
        });
        if (cur.elements.length > 0 || cur.h3) steps.push(cur);

        // Inherit media forward for steps without their own figure
        let lastMedia = -1;
        steps.forEach(s => {
          if (s.mediaId >= 0) lastMedia = s.mediaId;
          else s.mediaId = lastMedia;
        });

        ch.steps = steps;
      } else if (hasFigures) {
        // Figure-based steps (continuous section with images)
        const steps: ScrollyStep[] = [];
        let buf: HTMLElement[] = [];

        ch.elements.forEach(el => {
          if (isExtractable(el)) {
            const mId = nextMediaId++;
            allMedia.push({ id: mId, figure: el });
            steps.push({ elements: buf, mediaId: mId });
            buf = [];
          } else {
            buf.push(el);
          }
        });
        if (buf.length > 0) {
          steps.push({
            elements: buf,
            mediaId: steps.length > 0 ? steps[steps.length - 1].mediaId : -1,
          });
        }

        ch.steps = steps;
      } else {
        // No H3s and no figures → single step, no media
        ch.steps = [{ elements: ch.elements, mediaId: -1 }];
      }
    });

    // 3. Build the scrolly DOM
    const wrapper = document.createElement('div');
    wrapper.className = 'scrolly-wrapper';

    const mediaPane = document.createElement('div');
    mediaPane.className = 'scrolly-media';
    mediaPane.setAttribute('aria-hidden', 'true');

    const narrativePane = document.createElement('div');
    narrativePane.className = 'scrolly-narrative';

    // Create media frames in the sticky pane
    allMedia.forEach(m => {
      const frame = document.createElement('div');
      frame.className = 'scrolly-media-frame';
      frame.dataset.mediaId = String(m.id);
      frame.appendChild(m.figure.cloneNode(true));
      mediaPane.appendChild(frame);
    });

    // Rebuild post-body content into scrolly sections
    postBody.innerHTML = '';

    // Intro (content before first H2)
    if (introElements.length > 0) {
      const intro = document.createElement('div');
      intro.className = 'scrolly-intro';
      introElements.forEach(el => intro.appendChild(el));
      postBody.appendChild(intro);
    }

    // Chapters and steps
    let stepIdx = 0;
    chapters.forEach(ch => {
      const section = document.createElement('section');
      section.className = 'scrolly-chapter';
      section.dataset.chapterSlug = ch.heading.id;

      ch.steps.forEach((step, sIdx) => {
        const stepDiv = document.createElement('div');
        stepDiv.className = 'scrolly-step';
        stepDiv.dataset.stepIndex = String(stepIdx);
        stepDiv.dataset.mediaId = String(step.mediaId);

        // First step in chapter gets the H2 heading
        if (sIdx === 0) stepDiv.appendChild(ch.heading);
        // H3 heading if present
        if (step.h3) stepDiv.appendChild(step.h3);
        // Step content
        step.elements.forEach(el => stepDiv.appendChild(el));

        section.appendChild(stepDiv);
        stepIdx++;
      });

      postBody.appendChild(section);
    });

    // Assemble: move content into narrative pane, add wrapper to layout container
    narrativePane.appendChild(postBody);
    wrapper.appendChild(mediaPane);
    wrapper.appendChild(narrativePane);
    layoutContainer.appendChild(wrapper);

    // 4. Lightbox target management: avoid duplicates between sticky and narrative
    const mq = window.matchMedia('(min-width: 1025px)');

    function updateLightboxTargets() {
      const isDesktop = mq.matches;

      // Narrative inline images: disable lightbox on desktop (ghost images)
      postBody.querySelectorAll('.scrolly-step figure img').forEach(img => {
        const el = img as HTMLImageElement;
        if (isDesktop) {
          el.classList.add('no-lightbox');
          el.onclick = null;
          el.style.cursor = '';
        } else {
          el.classList.remove('no-lightbox');
        }
      });

      // Sticky pane images: disable lightbox on mobile (pane is hidden)
      mediaPane.querySelectorAll('img').forEach(img => {
        const el = img as HTMLImageElement;
        if (!isDesktop) {
          el.classList.add('no-lightbox');
          el.onclick = null;
          el.style.cursor = '';
        } else {
          el.classList.remove('no-lightbox');
        }
      });

      // Re-attach lightbox handlers for the active set
      requestAnimationFrame(() => {
        if (typeof (window as any).__attachLightboxListeners === 'function') {
          (window as any).__attachLightboxListeners();
        }
      });
    }

    mq.addEventListener('change', updateLightboxTargets);
    // Defer initial call so Lightbox has time to initialize
    requestAnimationFrame(() => updateLightboxTargets());

    // 5. Scroll observation
    setupScrollObserver(mediaPane, postBody);
  }

  /* ─── Scroll Observer ─── */

  function setupScrollObserver(mediaPane: HTMLElement, content: HTMLElement) {
    const steps = content.querySelectorAll('.scrolly-step');
    const frames = mediaPane.querySelectorAll('.scrolly-media-frame');
    const tocItems = document.querySelectorAll('.sticky-toc ul > li[data-chapter]');

    let activeMediaId = -2; // -2 = nothing yet, -1 = step has no media
    const intersecting = new Map<Element, number>();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          intersecting.set(entry.target, entry.intersectionRatio);
        } else {
          intersecting.delete(entry.target);
        }
      });

      // Find the step closest to the reading position (upper-middle viewport)
      let bestStep: Element | null = null;
      let bestDist = Infinity;
      const readY = window.innerHeight * 0.35;

      intersecting.forEach((_, step) => {
        const rect = (step as HTMLElement).getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const dist = Math.abs(center - readY);
        if (dist < bestDist) {
          bestDist = dist;
          bestStep = step;
        }
      });

      if (!bestStep) return;

      const mId = parseInt((bestStep as HTMLElement).dataset.mediaId ?? '-1');

      // Update sticky pane media
      if (mId >= 0 && mId !== activeMediaId) {
        frames.forEach(f => {
          const fId = parseInt((f as HTMLElement).dataset.mediaId ?? '-1');
          f.classList.toggle('active', fId === mId);
        });
        activeMediaId = mId;
      }

      // Update TOC active chapter
      const chapter = (bestStep as HTMLElement).closest('.scrolly-chapter');
      if (chapter) {
        const slug = (chapter as HTMLElement).dataset.chapterSlug;
        if (slug) {
          tocItems.forEach(item => {
            item.classList.toggle('active', (item as HTMLElement).dataset.chapter === slug);
          });
        }
      }
    }, {
      // Trigger zone: middle 20% of viewport (35% from top, 55% from bottom)
      rootMargin: '-35% 0px -55% 0px',
      threshold: [0, 0.25, 0.5, 0.75],
    });

    steps.forEach(s => observer.observe(s));
  }

  /* ─── Initialization ─── */

  function init() {
    autoCaptions();
    setupScrollytelling();
    setupDropcaps();
    syncHeaderBg();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
