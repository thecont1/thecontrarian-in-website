---
import { render, type CollectionEntry } from "astro:content";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AUTHOR } from "../data/author";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/code.css";

interface Props {
  post: CollectionEntry<"code">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.lastUpdated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}) || post.data.createdDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const metaDescription = post.data.description || AUTHOR.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(AUTHOR.image, Astro.site).href;

const codeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: post.data.title,
  ...(post.data.description && { description: post.data.description }),
  ...(post.data.createdDate && { dateCreated: post.data.createdDate.toISOString() }),
  ...(post.data.repoUrl && { codeRepository: post.data.repoUrl }),
  ...(post.data.license && { license: post.data.license }),
  ...(post.data.appUrl && { url: post.data.appUrl }),
  author: {
    "@type": "Person",
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: AUTHOR.sameAs,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
};

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name,
  url: AUTHOR.url,
  email: AUTHOR.email,
  jobTitle: AUTHOR.jobTitle,
  description: AUTHOR.description,
  image: ogImage,
  sameAs: AUTHOR.sameAs,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} | Code Project | Mahesh Shantaram</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="google-adsense-account" content="ca-pub-3564536130489009" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <meta property="og:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Mahesh Shantaram" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@thecontrarian" />
  <meta name="twitter:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(codeJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
</head>

<body>
  <canvas id="snow-canvas" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  
  <SiteHeader />

  <div class="repo-page">
    <header class="repo-header">
      <div class="repo-header-inner">
        <nav class="repo-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/code">Code</a>
          <span>/</span>
          <span>{post.data.repoName}</span>
        </nav>

        <div class="repo-main-info">
          <div class="repo-icon-wrap">
            <svg width="48" height="48" viewBox="0 0 16 16" fill="currentColor" class="repo-icon" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </div>

          <div class="repo-title-block">
            <h1 class="repo-title">{post.data.repoOwner} / {post.data.repoName}</h1>
            {post.data.author && <p class="repo-author">by {post.data.author}{post.data.repoEmail && <> · <a href={`mailto:${post.data.repoEmail}`}>{post.data.repoEmail}</a></>}</p>}
            {post.data.description && <p class="repo-subtitle">{post.data.description}</p>}
            <div class="repo-meta">
              {post.data.license && <span class="repo-license">{post.data.license}</span>}
              {formattedDate && <span class="repo-date">Updated {formattedDate}</span>}
            </div>
          </div>

          <div class="repo-actions">
            {post.data.repoUrl && (
              <a class="repo-link" href={post.data.repoUrl} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                </svg>
                View on GitHub
              </a>
            )}
            {post.data.appUrl && (
              <a class="repo-link" href={post.data.appUrl} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M3.75 2h3.5a.75.75 0 010 1.5H4.5v8h8V8.75a.75.75 0 011.5 0v3.5A1.75 1.75 0 0112.25 14h-8.5A1.75 1.75 0 012 12.25v-8.5C2 2.784 2.784 2 3.75 2zm6.72.72l3 3a.75.75 0 010 1.06l-3 3a.75.75 0 11-1.06-1.06l1.72-1.72H7a.75.75 0 010-1.5h4.13L9.41 3.78a.75.75 0 011.06-1.06z" />
                </svg>
                Live App
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="repo-content" tabindex="-1">
      <div class="repo-container">
        <div class="content-wrapper">
          <aside class="repo-sidebar">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="repo-panel topics-panel">
                <h3>Topics</h3>
                <div class="repo-tags">
                  {post.data.tags.map((tag) => (
                    <span class="repo-tag">{tag}</span>
                  ))}
                </div>
              </div>
            )}

            {post.data.fileTree && post.data.fileTree.length > 0 && (() => {
              // Build nested tree from flat paths
              const tree = {};
              for (const fp of post.data.fileTree) {
                const parts = fp.split('/');
                let node = tree;
                for (let i = 0; i < parts.length; i++) {
                  const part = parts[i];
                  if (i === parts.length - 1) {
                    node[part] = null; // file
                  } else {
                    if (!node[part]) node[part] = {};
                    node = node[part];
                  }
                }
              }

              function renderNode(obj, name = '') {
                const entries = Object.entries(obj).sort(([a, va], [b, vb]) => {
                  // directories first, then alphabetical
                  if (va !== null && vb === null) return -1;
                  if (va === null && vb !== null) return 1;
                  return a.localeCompare(b);
                });
                return entries.map(([key, val]) => {
                  if (val === null) {
                    // file
                    const ext = key.split('.').pop() || '';
                    const icon = ext === 'md' || ext === 'mdx' ? 'M' : ext === 'py' ? 'Py' : ext === 'js' || ext === 'ts' ? 'JS' : ext === 'css' ? 'CS' : ext === 'html' ? 'H' : ext === 'json' ? '{}' : ext === 'toml' || ext === 'yaml' || ext === 'yml' ? '=' : 'F';
                    return <span class="tree-file"><span class={`tree-icon tree-icon-${ext}`}>{icon}</span>{key}</span>;
                  } else {
                    // directory
                    const childCount = Object.keys(val).length;
                    return <details class="tree-dir" open={childCount <= 8}>
                      <summary><span class="tree-dir-icon"></span>{key}/ <span class="tree-count">{childCount}</span></summary>
                      <div class="tree-children">{renderNode(val, key)}</div>
                    </details>;
                  }
                });
              }

              return (
                <div class="repo-panel filetree-panel">
                  <h3>Repository Files</h3>
                  <div class="file-tree" id="file-tree">
                    {renderNode(tree)}
                  </div>
                </div>
              );
            })()}
          </aside>

          <article class="repo-article">
            <Content />
          </article>
        </div>
      </div>
    </main>
  </div>

  <SiteFooter />

  <script is:inline src="/textmode.js" defer></script>
  <script is:inline src="/snow-loader.js" defer></script>
  <script is:inline src="/mobile-nav.js" defer></script>
</body>
</html>
