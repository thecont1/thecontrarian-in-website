---
import { type CollectionEntry } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import { createHmac } from "node:crypto";
import * as yaml from "js-yaml";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AUTHOR } from "../data/author";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/code.css";

interface Props {
  post: CollectionEntry<"code">;
}

interface TreeNode {
  [key: string]: TreeNode | null;
}

const { post } = Astro.props;

/* ── FlatWrite: fetch README + render via API ──────────── */

const FLATWRITE_API = import.meta.env.FLATWRITE_API || "https://flatwrite.md/api/render";
const SECRET = import.meta.env.INTERNAL_RENDER_KEY || "";

// Load design config from YAML
const designConfig = yaml.load(
  fs.readFileSync(path.resolve("src/styles/code.flatwrite.yaml"), "utf-8")
) as {
  docEngine: string;
  surfaceMode: string;
  framework: string;
  font: string;
  size: number;
  weight: number;
  line: number;
};

function sign(secret: string, ts: number, method_: string, path_: string) {
  return createHmac("sha256", secret).update(`${ts}.${method_}.${path_}`).digest("hex");
}

function resolveReadmeUrl(post: CollectionEntry<"code">) {
  if (post.data.readmeUrl) return post.data.readmeUrl;
  return `https://raw.githubusercontent.com/${post.data.repoOwner}/${post.data.repoName}/${post.data.branch || 'main'}/README.md`;
}

function splitFragment(html: string) {
  const headMatch = html.match(/<head>([\s\S]*?)<\/head>/);
  const bodyMatch = html.match(/<body[^>]*>[\s\S]*?<\/body>/);
  return {
    head: headMatch ? headMatch[1].trim() : '',
    bodyTag: bodyMatch ? bodyMatch[0].trim() : '<body></body>',
  };
}

function extractStyles(headHtml: string) {
  const styles: string[] = [];
  const re = /<style>([\s\S]*?)<\/style>/g;
  let m;
  while ((m = re.exec(headHtml)) !== null) {
    styles.push(`<style>${m[1]}</style>`);
  }
  return styles.join('\n');
}

interface FlatwriteFragment {
  pageHeadStyles: string;
  iframeSrcdoc: string;
}

async function renderFlatwrite(markdownUrl: string): Promise<FlatwriteFragment> {
  if (!SECRET) throw new Error('INTERNAL_RENDER_KEY is not configured');
  const ts = Math.floor(Date.now() / 1000);
  const sig = sign(SECRET, ts, "POST", "/api/render");
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 8000);

  const body = {
    markdownUrl,
    surfaceMode: designConfig.surfaceMode || "doc",
    docEngine: designConfig.docEngine || "none",
    framework: designConfig.framework || "spectre",
    font: designConfig.font,
    size: designConfig.size,
    weight: designConfig.weight,
    line: designConfig.line,
  };

  try {
    const resp = await fetch(FLATWRITE_API, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Render-Timestamp": String(ts),
        "X-Render-Signature": sig,
      },
      body: JSON.stringify(body),
      signal: controller.signal,
    }).finally(() => clearTimeout(timeoutId));
    if (!resp.ok) throw new Error(`FlatWrite API returned ${resp.status}`);
    const fragment = await resp.text();
    const { head, bodyTag } = splitFragment(fragment);
    const pageHeadStyles = extractStyles(head);
    const iframeSrcdoc = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base target="_blank" rel="noopener noreferrer">
  ${head}
</head>
${bodyTag}
</html>`;
    return { pageHeadStyles, iframeSrcdoc };
  } catch (err) {
    const message = err instanceof Error ? (err.cause as Error)?.message || err.message : String(err);
    throw new Error(`FlatWrite render failed: ${message}`);
  }
}

// Build-time rendering: fetch the rendered README from the enriched URL.
const readmeUrl = resolveReadmeUrl(post);
const flatwrite = await renderFlatwrite(readmeUrl);

/* ── Standard metadata ─────────────────────────────────── */

const formattedDate = post.data.lastUpdated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}) || post.data.createdDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const metaDescription = post.data.description || AUTHOR.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(AUTHOR.image, Astro.site).href;

const codeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: post.data.title,
  ...(post.data.description && { description: post.data.description }),
  ...(post.data.createdDate && { dateCreated: post.data.createdDate.toISOString() }),
  ...(post.data.repoUrl && { codeRepository: post.data.repoUrl }),
  ...(post.data.license && { license: post.data.license }),
  ...(post.data.appUrl && { url: post.data.appUrl }),
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url, sameAs: AUTHOR.sameAs },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.href },
};

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name, url: AUTHOR.url, email: AUTHOR.email,
  jobTitle: AUTHOR.jobTitle, description: AUTHOR.description,
  image: ogImage, sameAs: AUTHOR.sameAs,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} | Code Project | Mahesh Shantaram</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="google-adsense-account" content="ca-pub-3564536130489009" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta property="og:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Mahesh Shantaram" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@thecontrarian" />
  <meta name="twitter:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(codeJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <Fragment set:html={flatwrite.pageHeadStyles} />
</head>

<body>
  <canvas id="snow-canvas" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteHeader />

  <main id="main-content" class="code-page" tabindex="-1">
    <header class="code-header">
      <div class="code-kicker">
        <span class="collection-type">Open Source</span>
      </div>
      <h1 class="code-title">{post.data.repoOwner} / {post.data.repoName}</h1>
      {post.data.description && <p class="code-subtitle">{post.data.description}</p>}
      {post.data.author && (
        <p class="code-author">
          by {post.data.author}
          {post.data.repoEmail && <> &middot; <a href={`mailto:${post.data.repoEmail}`}>{post.data.repoEmail}</a></>}
        </p>
      )}
      <div class="code-meta">
        {post.data.license && <span class="meta-license">{post.data.license}</span>}
        {formattedDate && <span class="meta-date">Updated {formattedDate}</span>}
      </div>
      <div class="code-actions">
        {post.data.repoUrl && (
          <a class="action-link" href={post.data.repoUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        )}
        {post.data.appUrl && (
          <a class="action-link" href={post.data.appUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M3.75 2h3.5a.75.75 0 010 1.5H4.5v8h8V8.75a.75.75 0 011.5 0v3.5A1.75 1.75 0 0112.25 14h-8.5A1.75 1.75 0 012 12.25v-8.5C2 2.784 2.784 2 3.75 2zm6.72.72l3 3a.75.75 0 010 1.06l-3 3a.75.75 0 11-1.06-1.06l1.72-1.72H7a.75.75 0 010-1.5h4.13L9.41 3.78a.75.75 0 011.06-1.06z"/></svg>
            Live App
          </a>
        )}
      </div>
    </header>

    <section class="code-body">
      <div class="code-container">
        <div class="content-wrapper">
          <aside class="code-sidebar">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="sidebar-panel topics-panel">
                <h3>Topics</h3>
                <div class="sidebar-tags">
                  {post.data.tags.map((tag) => <span class="sidebar-tag">{tag}</span>)}
                </div>
              </div>
            )}
            {post.data.fileTree && post.data.fileTree.length > 0 && (() => {
              const tree: TreeNode = {};
              for (const fp of post.data.fileTree) {
                const parts = fp.split('/');
                let node = tree;
                for (let i = 0; i < parts.length; i++) {
                  const part = parts[i];
                  if (i === parts.length - 1) { node[part] = null; }
                  else { if (!node[part]) node[part] = {}; node = node[part] as TreeNode; }
                }
              }
              function countFiles(obj: TreeNode) {
                let n = 0;
                for (const v of Object.values(obj)) n += v === null ? 1 : countFiles(v);
                return n;
              }
              const repoBase = post.data.repoUrl || `https://github.com/${post.data.repoOwner}/${post.data.repoName}`;
              const branch = post.data.branch || 'main';
              function renderNode(obj: TreeNode, parentPath: string) {
                const entries = Object.entries(obj).sort(([a, va], [b, vb]) => {
                  if (va !== null && vb === null) return -1;
                  if (va === null && vb !== null) return 1;
                  return a.localeCompare(b);
                });
                return entries.map(([key, val]) => {
                  if (val === null) {
                    const ext = key.split('.').pop() || '';
                    const icon = ext === 'md' || ext === 'mdx' ? 'M' : ext === 'py' ? 'Py' : ext === 'js' || ext === 'ts' ? 'JS' : ext === 'css' ? 'CS' : ext === 'html' ? 'H' : ext === 'json' ? '{}' : ext === 'toml' || ext === 'yaml' || ext === 'yml' ? '=' : ext === 'sh' || ext === 'bash' ? '>' : ext === 'svg' ? 'S' : 'F';
                    const filePath = parentPath ? `${parentPath}/${key}` : key;
                    return <a class="tree-file" href={`${repoBase}/blob/${branch}/${filePath}`} target="_blank" rel="noopener noreferrer"><span class={`tree-icon tree-icon-${ext}`}>{icon}</span>{key}</a>;
                  } else {
                    const fileCount = countFiles(val);
                    const dirPath = parentPath ? `${parentPath}/${key}` : key;
                    return <details class="tree-dir" open={fileCount <= 12}>
                      <summary><span class="tree-dir-icon"></span>{key}/ <span class="tree-count">{fileCount}</span></summary>
                      <div class="tree-children">{renderNode(val, dirPath)}</div>
                    </details>;
                  }
                });
              }
              return (
                <div class="sidebar-panel filetree-panel">
                  <div class="filetree-header">
                    <h3>Files</h3>
                    <div class="filetree-actions">
                      <button type="button" class="filetree-btn" data-action="expand" aria-label="Expand all">+</button>
                      <button type="button" class="filetree-btn" data-action="collapse" aria-label="Collapse all">-</button>
                    </div>
                  </div>
                  <div class="file-tree" id="file-tree">{renderNode(tree, '')}</div>
                </div>
              );
            })()}
          </aside>
          <article class="code-article">
            <div class="flatwrite-wrapper">
              <iframe
                class="flatwrite-iframe"
                title={`${post.data.title} — README`}
                srcdoc={flatwrite.iframeSrcdoc}
                loading="lazy"
              />
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script is:inline src="/textmode.js" defer></script>
  <script is:inline src="/snow-loader.js" defer></script>
  <script is:inline src="/mobile-nav.js" defer></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var tree = document.getElementById('file-tree');
      if (!tree) return;
      tree.addEventListener('click', function(e) {
        var btn = e.target.closest('.filetree-btn');
        if (!btn) return;
        var action = btn.getAttribute('data-action');
        var dirs = tree.querySelectorAll('details.tree-dir');
        for (var i = 0; i < dirs.length; i++) dirs[i].open = action === 'expand';
      });
    });
  </script>
  <script is:inline>
    (function() {
      var iframe = document.querySelector('.flatwrite-iframe');
      if (!iframe) return;

      function resize() {
        try {
          var doc = iframe.contentDocument || iframe.contentWindow.document;
          var height = doc.documentElement.scrollHeight || doc.body.scrollHeight;
          iframe.style.height = height + 'px';
        } catch(e) {}
      }

      iframe.addEventListener('load', resize);
      iframe.addEventListener('load', function() {
        setTimeout(resize, 300);
        setTimeout(resize, 1000);
      });
      window.addEventListener('resize', resize);
    })();
  </script>
</body>
</html>
