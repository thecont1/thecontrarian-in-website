---
import { type CollectionEntry } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import { execSync } from "node:child_process";
import { createHmac } from "node:crypto";
import * as yaml from "js-yaml";
import { marked } from "marked";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AUTHOR } from "../data/author";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/code.css";

interface Props {
  post: CollectionEntry<"code">;
}

interface TreeNode {
  [key: string]: TreeNode | null;
}

const { post } = Astro.props;

/* ── GitHub file tree cache (build-time, change-detected) ──────────── */

const FILETREE_CACHE_DIR = path.resolve(".cache");
const FILETREE_CACHE_FILE = path.join(FILETREE_CACHE_DIR, "code-filetrees.json");

interface CachedTree {
  pushedAt: string;
  tree: string[];
}

function readFileTreeCache(): Record<string, CachedTree> {
  try {
    return JSON.parse(fs.readFileSync(FILETREE_CACHE_FILE, "utf-8"));
  } catch {
    return {};
  }
}

function writeFileTreeCache(cache: Record<string, CachedTree>) {
  if (!fs.existsSync(FILETREE_CACHE_DIR)) {
    fs.mkdirSync(FILETREE_CACHE_DIR, { recursive: true });
  }
  fs.writeFileSync(FILETREE_CACHE_FILE, JSON.stringify(cache, null, 2));
}

function ghApi(endpoint: string): any {
  try {
    const out = execSync(`gh api "${endpoint}"`, { encoding: "utf8", maxBuffer: 1024 * 1024 });
    return JSON.parse(out);
  } catch {
    return null;
  }
}

function getRepoFileTree(repoOwner: string, repoName: string, branch: string): string[] {
  const repoKey = `${repoOwner}/${repoName}`;
  const cache = readFileTreeCache();

  const repoData = ghApi(`/repos/${repoOwner}/${repoName}`);
  if (!repoData) {
    console.error(`[Code.astro] GitHub repo metadata fetch failed for ${repoKey}`);
    return cache[repoKey]?.tree || [];
  }

  const pushedAt = repoData.pushed_at;
  if (cache[repoKey]?.pushedAt === pushedAt) {
    return cache[repoKey].tree;
  }

  const treeData = ghApi(`/repos/${repoOwner}/${repoName}/git/trees/${branch}?recursive=1`);
  const tree: string[] = treeData?.tree
    ? treeData.tree.filter((item: any) => item.type === "blob").map((item: any) => item.path)
    : [];

  cache[repoKey] = { pushedAt, tree };
  writeFileTreeCache(cache);

  return tree;
}

const repoFileTree = getRepoFileTree(post.data.repoOwner, post.data.repoName, post.data.branch || "main");

/* ── FlatWrite: fetch README + render via API ──────────── */

// SERVER-ONLY: these env vars are read during Astro's build-time frontmatter
// execution. They must NEVER be prefixed with PUBLIC_ or referenced in client
// code, otherwise they would be shipped to the browser.
function getServerSecret(key: string): string {
  if (typeof window !== 'undefined' || typeof document !== 'undefined') {
    throw new Error(`Server-only env var ${key} accessed in client context`);
  }
  const value = import.meta.env[key];
  if (!value) throw new Error(`${key} is not configured`);
  return value;
}

const FLATWRITE_API = import.meta.env.FLATWRITE_API || "https://flatwrite.md/api/render";
let SECRET = '';
try {
  SECRET = getServerSecret('INTERNAL_RENDER_KEY');
} catch (err) {
  const message = err instanceof Error ? err.message : String(err);
  console.error('[Code.astro]', message);
}

// Load design config from YAML
const designConfig = yaml.load(
  fs.readFileSync(path.resolve("src/styles/code.flatwrite.yaml"), "utf-8")
) as {
  docEngine: string;
  surfaceMode: string;
  framework: string;
  font: string;
  size: number;
  weight: number;
  line: number;
};

function sign(secret: string, ts: number, method_: string, path_: string) {
  return createHmac("sha256", secret).update(`${ts}.${method_}.${path_}`).digest("hex");
}

const ALLOWED_MARKDOWN_HOSTS = new Set([
  'raw.githubusercontent.com',
  'raw.gitlab.com',
  'bitbucket.org',
]);

function isValidMarkdownUrl(url: string): boolean {
  try {
    const parsed = new URL(url);
    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return false;
    return ALLOWED_MARKDOWN_HOSTS.has(parsed.hostname);
  } catch {
    return false;
  }
}

function resolveReadmeUrl(post: CollectionEntry<"code">): string {
  const url = post.data.readmeUrl
    || `https://raw.githubusercontent.com/${post.data.repoOwner}/${post.data.repoName}/${post.data.branch || 'main'}/README.md`;
  if (!isValidMarkdownUrl(url)) {
    let host: string;
    try { host = new URL(url).hostname; } catch { host = 'invalid'; }
    throw new Error(`Disallowed markdownUrl host: ${host}`);
  }
  return url;
}

interface FlatwriteApiResponse {
  head: string;
  body: string;
}

function parseFragmentResponse(text: string): FlatwriteApiResponse | null {
  try {
    const parsed = JSON.parse(text);
    if (typeof parsed.head !== 'string' || typeof parsed.body !== 'string') return null;
    return parsed;
  } catch {
    return null;
  }
}

function simpleSanitizeHtml(html: string): string {
  return html
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/<embed\b[^<]*(?:(?!<\/embed>)<[^<]*)*<\/embed>/gi, '')
    .replace(/on\w+\s*=/gi, '');
}

async function renderLocalMarkdownFallback(markdownUrl: string): Promise<string | null> {
  try {
    const resp = await fetch(markdownUrl, { headers: { Accept: 'text/markdown,text/plain' } });
    if (!resp.ok) return null;
    const markdown = await resp.text();
    const html = marked.parse(markdown);
    return simpleSanitizeHtml(html);
  } catch (err) {
    console.error('[Code.astro] Local markdown fallback failed:', err);
    return null;
  }
}

function extractStyles(headHtml: string) {
  const styles: string[] = [];
  const re = /<style>([\s\S]*?)<\/style>/g;
  let m;
  while ((m = re.exec(headHtml)) !== null) {
    styles.push(sanitizeFlatwriteCss(m[1]));
  }
  return styles.join('\n');
}

function sanitizeFlatwriteCss(css: string) {
  let cleaned = String(css)
    .replace(/<[^>]+>/g, '')
    .replace(/<!--|-->/g, '')
    .replace(/@import\b[^;]*;/gi, '')
    .replace(/@charset\b[^;]*;/gi, '')
    .replace(/@namespace\b[^;]*;/gi, '')
    .replace(/@font-face\s*\{[^}]*\}/gi, '')
    .replace(/url\(\s*(['"]?)(?!data:)([^)\1]+)\1\s*\)/gi, 'url()');
  return cleaned.trim();
}

interface FlatwriteFragment {
  pageHeadStyles: string;
  iframeSrcdoc?: string;
  fallbackHtml?: string;
}

async function renderFlatwrite(markdownUrl: string): Promise<FlatwriteFragment> {
  if (!SECRET) throw new Error('INTERNAL_RENDER_KEY is not configured');
  if (!isValidMarkdownUrl(markdownUrl)) throw new Error('Disallowed markdownUrl');
  const ts = Math.floor(Date.now() / 1000);
  const sig = sign(SECRET, ts, "POST", "/api/render");
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 8000);

  const body = {
    markdownUrl,
    surfaceMode: designConfig.surfaceMode || "doc",
    docEngine: designConfig.docEngine || "none",
    framework: designConfig.framework || "spectre",
    font: designConfig.font,
    size: designConfig.size,
    weight: designConfig.weight,
    line: designConfig.line,
  };

  try {
    const resp = await fetch(FLATWRITE_API, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Render-Timestamp": String(ts),
        "X-Render-Signature": sig,
      },
      body: JSON.stringify(body),
      signal: controller.signal,
    }).finally(() => clearTimeout(timeoutId));
    if (!resp.ok) throw new Error(`FlatWrite API returned ${resp.status} for ${markdownUrl}`);
    const text = await resp.text();
    const fragment = parseFragmentResponse(text);
    if (!fragment) throw new Error(`Invalid FlatWrite API response for ${markdownUrl} (status ${resp.status})`);
    const pageHeadStyles = extractStyles(fragment.head);

    // FlatWrite's API returns self-contained <head>...</head> and <body>...</body>
    // fragments. Strip the outer head/body wrappers so we can splice our own
    // meta tags + base + body override styles in without producing duplicate
    // <head> / <body> nesting (which the HTML parser tolerates but breaks
    // the resize cross-origin access path and confuses some browsers).
    const headInner = fragment.head
      .replace(/^<head[^>]*>/i, '')
      .replace(/<\/head>\s*$/i, '');
    const bodyInner = fragment.body
      .replace(/^<body[^>]*>/i, '')
      .replace(/<\/body>\s*$/i, '');

    const iframeSrcdoc = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base target="_blank" rel="noopener noreferrer">
  ${headInner}
  <style>
    html, body { background: #c7e3ff !important; overflow: hidden !important; }
    .fw-render { background: #c7e3ff !important; color: #1a233a !important; }
    .fw-render a { color: #0c4a6e !important; }
    .fw-render a:hover { color: #1e7bb4 !important; }
    .fw-render h1, .fw-render h2, .fw-render h3, .fw-render h4, .fw-render h5, .fw-render h6 { color: #0c1222 !important; }
    .fw-render blockquote { border-left-color: #c7e3ff !important; }
    .fw-render pre { background: #3a5a7e !important; color: #ffffff !important; font-size: 0.85em !important; padding: 1em !important; }
    .fw-render code { background: #3a5a7e !important; color: #ffffff !important; font-size: 0.85em !important; padding: 0.2em 0.4em !important; }
    .fw-render pre code { font-size: 1em !important; padding: 0 !important; }
    .fw-render table th, .fw-render table td { border-color: #cbd5e1 !important; }
    .fw-render thead th { background: #0c1222 !important; color: #c7e3ff !important; }
    .fw-render tbody tr:nth-child(even) { background: #b3d6ff !important; }
    .fw-render tbody tr:nth-child(odd) { background: #c7e3ff !important; }
  </style>
</head>
<body class="fw-render">
  ${bodyInner}
</body>
</html>`;
    return { pageHeadStyles, iframeSrcdoc };
  } catch (err) {
    const message = err instanceof Error ? (err.cause as Error)?.message || err.message : String(err);
    throw new Error(`FlatWrite render failed: ${message}`);
  }
}

// Build-time rendering: fetch the rendered README from the enriched URL.
let flatwrite: FlatwriteFragment | null = null;
let flatwriteError: string | null = null;
let readmeUrlForLog: string | null = null;

try {
  const readmeUrl = resolveReadmeUrl(post);
  readmeUrlForLog = readmeUrl;
  flatwrite = await renderFlatwrite(readmeUrl);
} catch (err) {
  flatwriteError = err instanceof Error ? err.message : String(err);
  console.error(
    '[Code.astro] FlatWrite render failed:',
    {
      repo: `${post.data.repoOwner}/${post.data.repoName}`,
      readmeUrl: readmeUrlForLog,
      error: flatwriteError,
    }
  );
  if (readmeUrlForLog) {
    const fallbackHtml = await renderLocalMarkdownFallback(readmeUrlForLog);
    if (fallbackHtml) {
      flatwrite = {
        pageHeadStyles: '',
        fallbackHtml,
      };
      flatwriteError = null;
    }
  }
}

/* ── Standard metadata ─────────────────────────────────── */

const formattedDate = post.data.lastUpdated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}) || post.data.createdDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const metaDescription = post.data.description || AUTHOR.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Use GitHub's opengraph image for the corresponding repo so social
// previews show the repo's name, description, contributor count, etc.
// (rendered from https://github.com/thecont1/<repo>/settings — these
// are the social-preview images GitHub itself serves).
const ogImage = `https://opengraph.githubassets.com/0/${post.data.repoOwner}/${post.data.repoName}`;

const codeJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: post.data.title,
  ...(post.data.description && { description: post.data.description }),
  ...(post.data.createdDate && { dateCreated: post.data.createdDate.toISOString() }),
  ...(post.data.repoUrl && { codeRepository: post.data.repoUrl }),
  ...(post.data.license && { license: post.data.license }),
  ...(post.data.appUrl && { url: post.data.appUrl }),
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url, sameAs: AUTHOR.sameAs },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.href },
};

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name, url: AUTHOR.url, email: AUTHOR.email,
  jobTitle: AUTHOR.jobTitle, description: AUTHOR.description,
  image: ogImage, sameAs: AUTHOR.sameAs,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{post.data.title} | Code Project | Mahesh Shantaram</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content="index, follow" />
  <meta name="google-adsense-account" content="ca-pub-3564536130489009" />
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <meta property="og:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Mahesh Shantaram" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@thecontrarian" />
  <meta name="twitter:title" content={`${post.data.title} | Code Project | Mahesh Shantaram`} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(codeJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  {flatwrite && <style is:global set:html={flatwrite.pageHeadStyles}></style>}
</head>

<body>
  <canvas id="snow-canvas" aria-hidden="true"></canvas>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <SiteHeader />

  <main id="main-content" class="code-page" tabindex="-1">
    <header class="code-header">
      <div class="code-kicker">
        <span class="collection-type">Open Source</span>
      </div>
      <h1 class="code-title">{post.data.repoOwner} / {post.data.repoName}</h1>
      {post.data.description && <p class="code-subtitle">{post.data.description}</p>}
      {post.data.author && (
        <p class="code-author">
          by {post.data.author}
          {post.data.repoEmail && <> &middot; <a href={`mailto:${post.data.repoEmail}`}>{post.data.repoEmail}</a></>}
        </p>
      )}
      <div class="code-meta">
        {post.data.license && <span class="meta-license">{post.data.license}</span>}
        {formattedDate && <span class="meta-date">Updated {formattedDate}</span>}
      </div>
      <div class="code-actions">
        {post.data.repoUrl && (
          <a class="action-link" href={post.data.repoUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        )}
        {post.data.appUrl && (
          <a class="action-link" href={post.data.appUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M3.75 2h3.5a.75.75 0 010 1.5H4.5v8h8V8.75a.75.75 0 011.5 0v3.5A1.75 1.75 0 0112.25 14h-8.5A1.75 1.75 0 012 12.25v-8.5C2 2.784 2.784 2 3.75 2zm6.72.72l3 3a.75.75 0 010 1.06l-3 3a.75.75 0 11-1.06-1.06l1.72-1.72H7a.75.75 0 010-1.5h4.13L9.41 3.78a.75.75 0 011.06-1.06z"/></svg>
            Live App
          </a>
        )}
      </div>
    </header>

    <section class="code-body">
      <div class="code-container">
        <div class="content-wrapper">
          <aside class="code-sidebar">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="sidebar-panel topics-panel">
                <h3>Topics</h3>
                <div class="sidebar-tags">
                  {post.data.tags.map((tag) => <span class="sidebar-tag">{tag}</span>)}
                </div>
              </div>
            )}
            {repoFileTree.length > 0 && (() => {
              const tree: TreeNode = {};
              for (const fp of repoFileTree) {
                const parts = fp.split('/');
                let node = tree;
                for (let i = 0; i < parts.length; i++) {
                  const part = parts[i];
                  if (i === parts.length - 1) { node[part] = null; }
                  else { if (!node[part]) node[part] = {}; node = node[part] as TreeNode; }
                }
              }
              function countFiles(obj: TreeNode) {
                let n = 0;
                for (const v of Object.values(obj)) n += v === null ? 1 : countFiles(v);
                return n;
              }
              const repoBase = post.data.repoUrl || `https://github.com/${post.data.repoOwner}/${post.data.repoName}`;
              const branch = post.data.branch || 'main';
              function renderNode(obj: TreeNode, parentPath: string) {
                const entries = Object.entries(obj).sort(([a, va], [b, vb]) => {
                  if (va !== null && vb === null) return -1;
                  if (va === null && vb !== null) return 1;
                  return a.localeCompare(b);
                });
                return entries.map(([key, val]) => {
                  if (val === null) {
                    const ext = key.split('.').pop() || '';
                    const icon = ext === 'md' || ext === 'mdx' ? 'M' : ext === 'py' ? 'Py' : ext === 'js' || ext === 'ts' ? 'JS' : ext === 'css' ? 'CS' : ext === 'html' ? 'H' : ext === 'json' ? '{}' : ext === 'toml' || ext === 'yaml' || ext === 'yml' ? '=' : ext === 'sh' || ext === 'bash' ? '>' : ext === 'svg' ? 'S' : 'F';
                    const filePath = parentPath ? `${parentPath}/${key}` : key;
                    return <a class="tree-file" href={`${repoBase}/blob/${branch}/${filePath}`} target="_blank" rel="noopener noreferrer"><span class={`tree-icon tree-icon-${ext}`}>{icon}</span>{key}</a>;
                  } else {
                    const fileCount = countFiles(val);
                    const dirPath = parentPath ? `${parentPath}/${key}` : key;
                    return <details class="tree-dir">
                      <summary><span class="tree-dir-icon"></span>{key}/ <span class="tree-count">{fileCount}</span></summary>
                      <div class="tree-children">{renderNode(val, dirPath)}</div>
                    </details>;
                  }
                });
              }
              return (
                <div class="sidebar-panel filetree-panel">
                  <div class="filetree-header">
                    <h3>Files</h3>
                  </div>
                  <div class="file-tree" id="file-tree">{renderNode(tree, '')}</div>
                </div>
              );
            })()}
          </aside>
          <article class="code-article">
            <div class="flatwrite-wrapper">
              {flatwrite?.iframeSrcdoc ? (
                <iframe
                  class="flatwrite-iframe"
                  title={`${post.data.title} — README`}
                  srcdoc={flatwrite.iframeSrcdoc}
                  scrolling="no"
                />
              ) : flatwrite?.fallbackHtml ? (
                <div class="flatwrite-fallback flatwrite-local-render" set:html={flatwrite.fallbackHtml} />
              ) : (
                <div class="flatwrite-fallback">
                  <p>README preview is currently unavailable.</p>
                  {readmeUrlForLog && (
                    <p>
                      <a class="action-link" href={readmeUrlForLog} target="_blank" rel="noopener noreferrer">
                        View raw README
                      </a>
                    </p>
                  )}
                  {flatwriteError && (
                    <p class="flatwrite-error">{flatwriteError}</p>
                  )}
                </div>
              )}
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script is:inline src="/textmode.js" defer></script>
  <script is:inline src="/snow-loader.js" defer></script>
  <script is:inline src="/mobile-nav.js" defer></script>
  <script is:inline>
    (function() {
      var iframe = document.querySelector('.flatwrite-iframe');
      if (!iframe) return;

      function getDoc() {
        try {
          return iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document) || null;
        } catch (e) {
          return null;
        }
      }

      function resize() {
        var doc = getDoc();
        if (!doc) return;
        var body = doc.body;
        var html = doc.documentElement;
        if (!body || !html) return;
        // Use offsetHeight rather than scrollHeight so we get the laid-out
        // box height, which matches what the iframe needs to display without
        // internal scroll. scrollHeight can over-report when content extends
        // beyond the viewport.
        var height = Math.max(body.scrollHeight, body.offsetHeight, html.scrollHeight, html.offsetHeight);
        if (height && iframe.style.height !== height + 'px') {
          iframe.style.height = height + 'px';
        }
      }

      // Fire on the iframe's own load event (srcdoc fires this after parse).
      iframe.addEventListener('load', function() {
        resize();
        // Re-run after fonts/images settle in case layout changed.
        setTimeout(resize, 50);
        setTimeout(resize, 300);
        setTimeout(resize, 1000);
      });

      // If the iframe has already finished loading before this script ran
      // (rare, but possible when the script is deferred), the load listener
      // would never fire — call resize once now and poll briefly.
      resize();
      var pollCount = 0;
      var poll = setInterval(function() {
        resize();
        if (++pollCount > 20) clearInterval(poll);
      }, 100);

      // Observe content-size changes inside the iframe (images loading, etc.)
      // and re-resize. The observer is created lazily once the iframe is
      // accessible.
      var observerStarted = false;
      function startObserver() {
        var doc = getDoc();
        if (!doc || !doc.body || observerStarted) return;
        observerStarted = true;
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(resize).observe(doc.documentElement);
        }
      }
      iframe.addEventListener('load', startObserver);
      startObserver();

      window.addEventListener('resize', resize);
    })();
  </script>
</body>
</html>
